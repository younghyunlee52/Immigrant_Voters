```{r}
library(dplyr)

# Calculate the mean of immpol by country
mean_immpol_by_country <- ess_ches %>%
  group_by(country) %>%
  summarise(mean_immpol = mean(immpol, na.rm = TRUE))

# Show the result
print(mean_immpol_by_country)


library(dplyr)

mean_immpol_country = ess_ches %>%
  group_by(country, status) %>%
  summarise(mean_immpol = mean(immpol, na.rm = TRUE))

mean_imatt_country = ess_ches %>%
  group_by(country) %>%
  summarise(mean_imatt = mean(imatt, na.rm = TRUE))

mean_lrscale_country = ess_ches %>%
  group_by(country) %>%
  summarise(mean_lrscale = mean(lrscale, na.rm = TRUE))

# Combine the data frames by the 'country' column and round to 2 digits
combined_means <- mean_immpol_country %>%
  left_join(mean_imatt_country, by = "country") %>%
  left_join(mean_lrscale_country, by = "country") %>%
  mutate(across(starts_with("mean_"), ~ round(.x, 2)))

# Convert to LaTeX table
latex_table <- combined_means %>%
  knitr::kable(format = "latex", booktabs = TRUE)

knitr::kable(combined_means)

# Print the LaTeX code for the table
cat(latex_table)

mean(ess_ches$immpol)
mean(ess_ches$imatt)
mean(ess_ches$lrscale)

```

