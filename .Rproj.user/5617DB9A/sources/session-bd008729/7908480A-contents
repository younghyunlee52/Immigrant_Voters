```{r}
#making a new column
ess9$party = NA
library(dplyr)

# Assuming ess9 is your dataframe
ess9 <- ess9 %>%
  mutate(party = coalesce(at9, be9, bg9, cz9, de9, dk9, ee9, es9, fi9, fr9,
                          gb9, hr9, hu9, ie9, it9, lt9, nl9, pl9, pt9, se9,
                          si9, sk9, cy9)) %>%
  select(-at9, -be9, -bg9, -cz9, -de9, -dk9, -ee9, -es9, -fi9, -fr9,
         -gb9, -hr9, -hu9, -ie9, -it9, -lt9, -nl9, -pl9, -pt9, -se9,
         -si9, -sk9, -cy9)

table(ess9$party, useNA= "always")
table(ess9$country[is.na(ess9$party)])

#write.csv(ess9,"D:/GitHub/voters_immigration/data/ess9_ches.csv", row.names = FALSE)
write.csv(ess9, file = here("data", "ess9_ches.csv"), row.names = FALSE)

table(ess9$status)
```

