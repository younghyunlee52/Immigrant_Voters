```{r}
library(dplyr)

# Step 1: Aggregate the data to get the mean (or another appropriate measure) of immigrate_policy for each party in each country
party_aggregated <- ess_ches %>%
  group_by(country, party) %>%
  summarise(immigrate_policy = mean(immigrate_policy, na.rm = TRUE)) %>%
  ungroup()

# Step 2: Create a new column that combines party names with their corresponding immigration policy values
party_aggregated <- party_aggregated %>%
  mutate(party_value = paste0(party, " (", round(immigrate_policy, 2), ")"))

# Step 3: Group by country and concatenate the party_value entries
country_party_table <- party_aggregated %>%
  group_by(country) %>%
  summarise(parties = paste(party_value, collapse = ", ")) %>%
  ungroup()

# Step 4: Display the resulting table
print(country_party_table)

latex2 = xtable(country_party_table)

```
















