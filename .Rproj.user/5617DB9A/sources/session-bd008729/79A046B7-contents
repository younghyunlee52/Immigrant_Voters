#Figure 4
```{r}
ess_ches %>%
  group_by(country, imatt,status) %>%
  summarize(mean=mean(anti_imm), sd=sd(anti_imm)) -> essaggdat_anti2

ggplot(essaggdat_anti2) + 
  geom_smooth(aes(x=imatt, y=mean,color=status), method="lm",
              linewidth=.5,se=F) +
  facet_wrap(~country, ncol=4) + theme_bw() +
  scale_color_brewer(palette = "Set1", name="Status",
                     labels=c("Native", "First gen", "Second gen"))+ 
  theme(legend.position = c(0.9,0.07),
        legend.box.background = element_rect(colour = "black"),
        text=element_text(size=13)) +
  labs(x="Immigration attitude", y="Support for anti-immigration parties")

ggsave(here::here("Figures", "Figure 4.png"), width=8,height=9)
```



