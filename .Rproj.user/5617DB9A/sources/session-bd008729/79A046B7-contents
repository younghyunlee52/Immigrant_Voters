#Data Loading and Recoding
```{r}
ess_ches = read.csv(here::here("data", "ess_ches.csv"))

ess_ches$Christian = ifelse(ess_ches$religion == 1, 1, 0)
ess_ches$Muslim = ifelse(ess_ches$religion == 2, 1, 0)

ess_ches$imatt = NA
ess_ches$imatt = 1/3*(ess_ches$imbgeco + ess_ches$imueclt + ess_ches$imwbcnt)

ess_ches$immpol = NA
ess_ches$immpol = 1/3*(ess_ches$impol1 + ess_ches$impol2 + ess_ches$impol3)
```

#Regression Results

## Attitudes towards immigration

#Table 2: Voters' Attitudes Towards Immigrants and Party Choice
Table 2 provides results with immigrant attitudes as a main explanatory variable. 
```{r warning=FALSE}

##Immigrants make country worse or better place to live
h3fit1 = lm(immigrate_policy~imatt*status, data=ess_ches)
h3fit2 = lm(immigrate_policy~imatt*status + age+gender+Christian + Muslim +education, data=ess_ches)
h3fit3 = lm(immigrate_policy~imatt*status + age+gender+
               Christian + Muslim +education + country + factor(essround),
             data=ess_ches)
stargazer::stargazer(h3fit1, h3fit2, h3fit3, type="text",df=F,
                     omit=c("country","essround"))

stargazer::stargazer(h3fit1, h3fit2, h3fit3, type="latex",df=F,
                     omit=c("country","essround"),
                     out = here::here("Figures", "Table 2.tex"))
```

