H2: Party positions on immigration policies mainly affect the vote choice among voters with an immigration background in Europe.
  immigrate_policy ~ status*lrscale 
  
```{r warning=FALSE}
# change "native" as the reference level
ess_ches$status = as.factor(ess_ches$status)
ess_ches$status = relevel(ess_ches$status, ref = "native")

# outcome = immigrate_policy
h2fit1 = lm(immigrate_policy~lrscale*status, data=ess_ches)
h2fit2 = lm(immigrate_policy~lrscale*status + age+gender+Christian + Muslim +education, data=ess_ches)
h2fit3 = lm(immigrate_policy~lrscale*status + age+gender+
               Christian + Muslim +education + country + factor(essround),
             data=ess_ches)
summary(h2fit1); summary(h2fit2); summary(h2fit3)

stargazer::stargazer(h2fit1, h2fit2, h2fit3, type="text",df=F,
                     omit=c("country","essround"))

stargazer::stargazer(h2fit1, h2fit2, h2fit3,h2fit4, type="latex",df=F,
                     omit=c("country","essround"))


```  
  
H3: Attitudes towards immigration policy: 
  immigrate_policy ~ status*attitude_to_immigration/attitude_to_immigrants


#additive index: attitudes towards immigration policy 
```{r}
ess_ches$immpol = NA
ess_ches$immpol = 1/3*(ess_ches$impol1 + ess_ches$impol2 + ess_ches$impol3)

h3fit1 = lm(immigrate_policy~immpol*status, data=ess_ches)
h3fit2 = lm(immigrate_policy~immpol*status + age+gender+Christian + Muslim +education, data=ess_ches)
h3fit3 = lm(immigrate_policy~immpol*status + age+gender+
               Christian + Muslim +education + country + factor(essround),
             data=ess_ches)
stargazer::stargazer(h3fit1, h3fit2, h3fit3, type="text",df=F,
                     omit=c("country","essround"))
library(sjPlot)
library(ggplot2)
plot_model(h3fit3, type="pred",terms=c("immpol","status")) + theme_bw() 
```

