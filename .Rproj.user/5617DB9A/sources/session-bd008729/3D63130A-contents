# outcome = immigrate_policy
h1fit5 = lm(immigrate_policy~lrscale, data=ess_ches)
h1fit6 = lm(immigrate_policy~lrscale + age+gender+Christian + Muslim +education, data=ess_ches)
h1fit7 = plm(immigrate_policy~lrscale + age+gender+Christian + Muslim +education, data=ess_ches, 
              model="within", index=c("country","essround"))
h1fit8 = lm(immigrate_policy~lrscale + age+gender+Christian + Muslim +education + country + factor(essround),
             data=ess_ches)
