Load data
```{r}
Europe4 <- readRDS("Europe4.rds")
Europe2 <- readRDS("Europe2.rds")
essaggdat_anti2 <- readRDS("essaggdat_anti2.rds")
ess_sub <- readRDS("ess_sub.rds")
```


Maps

```{r}
# Figure 1
library(ggplot2)
ggplot(Europe4) +
  geom_sf(aes(fill=mean_immigrate_policy2)) +
  coord_sf(xlim = c(-20,35), ylim = c(35,72), expand = FALSE) +
  scale_fill_gradient(low="lightblue",high="darkblue",
                      na.value="gray95")+
  geom_sf_label(aes(label=mean_immigrate_policy_r),fill = "white", 
                 size=3) +
  theme_void() +
  theme(legend.position = "none",
        text=element_text(size=13)) 
ggsave("fig/europe_map2.png", width=10,height=7)

# Figure A1
ggplot(Europe2) +
  geom_sf(aes(fill=mean_immigrate_policy)) +
  coord_sf(xlim = c(-20,35), ylim = c(35,72), expand = FALSE) +
  scale_fill_gradient(low="#d1ffbd",high="darkgreen", 
                      breaks=c(4,5,6,7), 
                      labels=c("4 anti-immigration","5","6","7 pro-immigration"),
                      name="",
                      na.value="gray95")+
  geom_sf_label(aes(label=mean_immigrate_policy_r),fill = "white", 
                 size=3) +
  theme_void() +
  theme(legend.position = "right",legend.key.height = unit(.8, "cm"),
        text=element_text(size=13)) 

ggsave("fig/europe_map.png", width=10,height=7)
```

Figure 4 
```{r}
ggplot(essaggdat_anti2) + 
  geom_smooth(aes(x=imatt, y=mean,color=status), method="lm",
              linewidth=.5,se=F) +
  facet_wrap(~country, ncol=4) + theme_bw() +
  scale_color_brewer(palette = "Set1", name="Status",
                     labels=c("Native", "First gen", "Second gen"))+ 
  theme(legend.position = c(0.9,0.07),
        legend.box.background = element_rect(colour = "black"),
        text=element_text(size=13)) +
  labs(x="Immigration attitude", y="Support for anti-immigration parties")
ggsave("fig/immatt_and_antiparty_status.png", width=8,height=9)

```

Figure 7
```{r}
cohortfit1 = lm(immigrate_policy~immpol*(arrive_group) + gender+Christian + Muslim +education + country + factor(essround), data=ess_sub)

cohortfit2 = lm(immigrate_policy~imatt*(arrive_group) + gender+Christian + Muslim +education + country + factor(essround), data=ess_sub)

interplot::interplot(cohortfit1, var2="arrive_group",var1="immpol",point = T,
                    ercolor="gray30", color="gray30",size=2, esize=1) +
  theme_bw() + geom_hline(yintercept = 0, linetype="dashed", color="gray60") +
#  theme(axis.text.x = element_text(angle = 45, hjust=1)) +
  scale_x_continuous(breaks=seq(0,70,5),labels=seq(0,70,5))+
  labs(x="Age at arrival", y="Coefficients") +
  theme(text=element_text(size=14))
ggsave("fig/condition_immpol.png", width=7,height=5)

interplot::interplot(cohortfit2, var2="arrive_group",var1="imatt",point = T,
                    ercolor="gray30", color="gray30",size=2, esize=1)+
  theme_bw() + geom_hline(yintercept = 0, linetype="dashed", color="gray60") +
  scale_x_continuous(breaks=seq(0,70,5),labels=seq(0,70,5))+
  labs(x="Age at arrival", y="Coefficients")+
  theme(text=element_text(size=14))
ggsave("fig/condition_imatt.png", width=7,height=5)
