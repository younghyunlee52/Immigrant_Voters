# subsetting data to immigrant-background
```{r}
ess_raw = read.csv(here::here("data", "ESS6_10.csv"))
ess_raw <- ess_raw[ess_raw$cntry != "IS", ]

#subset
#only immigrant-origin respondents
ess_raw = ess_raw[!(ess_raw$brncntr > 2), ] #born in the country
ess_raw = ess_raw[!(ess_raw$facntr > 2), ] #father born in the country
ess_raw = ess_raw[!(ess_raw$mocntr > 2), ] #mother born in the country

ess_raw$status = NA
ess_raw = transform(ess_raw, 
       status=
       ifelse(brncntr == "1" & facntr == "1" & mocntr =="1", "native", # native
       ifelse(brncntr == "1" & facntr == "2" & mocntr == "1", "second", #2nd
       ifelse(brncntr == "1" & facntr == "1" & mocntr == "2", "second", #second generation
       ifelse(brncntr == "1" & facntr == "2" & mocntr == "2", "second", #second-generation 
       ifelse(brncntr == "2" & facntr == "1" & mocntr == "1", "native", #native 
        ifelse(brncntr == "2" & facntr == "1" & mocntr == "2", "first", #first generation
        ifelse(brncntr == "2" & facntr == "2" & mocntr == "1", "first", #first generation
                           "first"  #first-generation immigrant
                  ))))))))
                  
``` 


