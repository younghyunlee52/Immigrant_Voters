```{r eval=FALSE, include=FALSE}
#general
## imsmetn - Allow many/few immigrants of same race/ethnic group as  
## imdfetn - Allow many/few immigrants of d ... ace/ethnic group from majority
imm$general = NA
range(imm$imsmetn, na.rm= TRUE); range(imm$imdfetn, na.rm= TRUE)
imm$general = 1/8*(imm$imsmetn + imm$imdfetn)
range(imm$general, na.rm = TRUE)

#economic threat
## impcntr - Allow many/few immigrants from poorer countries outside Europe 
## imbgeco - Immigration bad or good for country's economy (1-10, 77 = refusal, 88 = DK, 99 = No answer) - economic threat
range(imm$impcntr, na.rm= TRUE); range(imm$imbgeco, na.rm= TRUE)
imm$econ = 1/2*(1/4*(imm$impcntr) + 1/10*(imm$imbgeco))
range(imm$econ, na.rm= TRUE)

#cultural threat

## imueclt - Country's cultural life undermined or enriched by immigrants (1-10, 77 = refusal, 88 = DK, 99 = No answer)
## imwbcnt - Immigrants make country worse or better place to live (1-10, 77 = refusal, 88 = DK, 99 = No answer)
imm$cultu = NA
range(imm$imueclt, na.rm= TRUE); range(imm$imwbcnt, na.rm= TRUE)
imm$cultu = 1/20*(imm$imueclt + imm$imwbcnt)
range(imm$cultu, na.rm= TRUE)

table(imm$cntry)
range(imm$lrscale)
