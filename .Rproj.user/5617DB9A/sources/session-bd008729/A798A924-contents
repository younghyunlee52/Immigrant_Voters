  filter(term != "(Intercept)") %>%
  mutate(term = recode(term,
                       "lrscale" = "Political Ideology",
                       "age" = "Age",
                       "gender" = "Gender",
                       "Christian" = "Christian ",
                       "Muslim" = "Muslim",
                       "education" = "Education ",
                       "eu" = "EU-Origin "
