#predicted plot attitudes towards immigrants
```{r}

first_model = glm(anti_imm ~ imatt, data = ess_ches, family = binomial)

# Create a sequence of values for the independent variable for a smoother curve
x_seq = seq(min(ess_ches$imatt), max(ess_ches$imatt), length.out = 100)

# Function to get predictions and confidence intervals
get_predictions = function(model, x_seq) {
  pred = predict(model, newdata = data.frame(imatt = x_seq), type = "link", se.fit = TRUE)
  predicted_prob = plogis(pred$fit)
  se = pred$se.fit
  alpha = 0.05
  z = qnorm(1 - alpha / 2)
  lower = plogis(pred$fit - z * se)
  upper = plogis(pred$fit + z * se)
  data.frame(imatt = x_seq, predicted_prob = predicted_prob, lower = lower, upper = upper)
}

# Get predictions for each group
native_predictions = get_predictions(native_model, x_seq)
first_predictions = get_predictions(first_model, x_seq)
second_predictions = get_predictions(second_model, x_seq)


# Combine predictions
predictions = rbind(native_predictions, first_predictions, second_predictions)

# Plot the data, predicted probabilities, and confidence intervals
predicted_plot = ggplot() +
  geom_point(data = ess_ches, aes(x = imatt, y = anti_imm, color = status), alpha = 0.5, position = position_jitter(height = 0.02)) +
  geom_line(data = predictions, aes(x = imatt, y = predicted_prob, color = status), size = 1) +
  geom_ribbon(data = predictions, aes(x = imatt, ymin = lower, ymax = upper, fill = status), alpha = 0.2) +
  labs(title = "Predicted Probability of Voting for Anti-Immigrant by Immigration Status",
       x = "Attitudes Towards Immigrants",
       y = "Predicted Probability of Voting for Anti-Immigrant") +
  scale_color_manual(values = c("native" = "blue", "first" = "green", "second" = "red")) +
  scale_fill_manual(values = c("native" = "blue", "first" = "green", "second" = "red")) + ylim(0.05, 0.7)

