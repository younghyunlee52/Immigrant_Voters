Cohort analysis
```{r}
library(tidyverse)

ess_sub <- read.csv("ess_sub.csv")
ess_sub %>%
  filter(status=="first") -> ess_sub 

ess_sub$livecnta[ess_sub$livecnta>2020] <-NA

ess_sub$arrive = ifelse(ess_sub$essround == 9,
                         ess_sub$age - (2018- ess_sub$livecnta),
                         ifelse(ess_sub$essround == 10,
                                ess_sub$age - (2020 - ess_sub$livecnta), NA))

ess_sub$arrive[ess_sub$arrive==-7] <- NA
table(ess_sub$arrive)

ess_sub$imatt = NA
ess_sub$imatt =1/3*(ess_sub$imbgeco + ess_sub$imueclt + ess_sub$imwbcnt)

ess_sub$immpol = NA
ess_sub$immpol = 1/3*(ess_sub$impol1 + ess_sub$impol2 + ess_sub$impol3)

ess_sub$Christian = ifelse(ess_sub$religion == 1, 1, 0)
ess_sub$Muslim = ifelse(ess_sub$religion == 2, 1, 0)

cohortfit1 = lm(immigrate_policy~immpol*(arrive_group) + gender+Christian + Muslim +education + country + factor(essround), data=ess_sub)

cohortfit2 = lm(immigrate_policy~imatt*(arrive_group) + gender+Christian + Muslim +education + country + factor(essround), data=ess_sub)

ess_sub$anti_imm = ifelse(is.na(ess_sub$immigrate_policy), NA,
                    ifelse(ess_sub$immigrate_policy > 7, 1, 0))

cohortfit3 = glm(anti_imm~immpol*(arrive_group) + gender+Christian + Muslim +education + country + factor(essround), data=ess_sub, family="binomial")

ess_sub$arrive_group <-  cut(ess_sub$arrive, breaks=seq(0,75,5), labels=seq(0,70,5))
ess_sub$arrive_group <- as.numeric(as.character(ess_sub$arrive_group))

library(ggplot2)
library(sjPlot)
plot_model(cohortfit1, type="pred", terms=c("arrive","immpol"))


interplot::interplot(cohortfit1, var2="arrive_group",var1="immpol",point = T,
                    ercolor="gray30", color="gray30",size=2, esize=1) +
  theme_bw() + geom_hline(yintercept = 0, linetype="dashed", color="gray60") +
#  theme(axis.text.x = element_text(angle = 45, hjust=1)) +
  scale_x_continuous(breaks=seq(0,70,5),labels=seq(0,70,5))+
  labs(x="Age at arrival", y="Coefficients") +
  theme(text=element_text(size=14))
#ggsave("fig/condition_immpol.png", width=7,height=5)

interplot::interplot(cohortfit2, var2="arrive_group",var1="imatt",point = T,
                    ercolor="gray30", color="gray30",size=2, esize=1)+
  theme_bw() + geom_hline(yintercept = 0, linetype="dashed", color="gray60") +
  scale_x_continuous(breaks=seq(0,70,5),labels=seq(0,70,5))+
  labs(x="Age at arrival", y="Coefficients")+
  theme(text=element_text(size=14))
#ggsave("fig/condition_imatt.png", width=7,height=5)

interplot::interplot(cohortfit3, var2="arrive_group",var1="immpol",point = T,
                    ercolor="gray30", color="gray30")+
