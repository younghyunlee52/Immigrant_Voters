# Extract coefficients and confidence intervals, excluding the intercept
coef_data <- tidy(h1fit6, conf.int = TRUE) %>%
  filter(term != "(Intercept)") %>%
  mutate(term = recode(term,
                       "lrscale" = "Political Ideology",
                       "age" = "Age",
                       "gender" = "Gender",
                       "Christian" = "Christian ",
                       "Muslim" = "Muslim",
                       "education" = "Education ",
                       "eu" = "EU-Origin "
  ))

# Define expanded x-axis range (adjust as needed)
x_min <- min(coef_data$conf.low) - 0.5
x_max <- max(coef_data$conf.high) + 0.5

# Create the coefficient plot
ggplot(coef_data, aes(x = estimate, y = reorder(term, estimate))) +
  geom_point(size = 3) +  # Larger points for clarity
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2) +  
  geom_vline(xintercept = 0, linetype = "dashed", color = "red") +  # Vertical line at zero
  labs(title = "Ideology and Party Choice (Including EU and Non-EU Origins)", x = "Coefficient Estimates", y = "Variables") +
  theme_minimal() +
  theme(
    plot.title = element_text(hjust = 0.5),  # Centered and bold title
    axis.text = element_text(size = 10),  # Increase axis text size for readability
    axis.title = element_text(size = 10)  # Increase axis label size
  ) +
  xlim(x_min, x_max)  # Expand x-axis range

