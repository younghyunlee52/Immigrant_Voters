#packages
```{r}
library(readr)
library(base)
library(here)
library(dplyr)
library(xtable)
library(stargazer)
```

#loading data
```{r}
ches = read.csv(here::here("data", "ches1419.csv"))
ches = ches[ches$year == 2019, ]
ess9 = read.csv(here::here("data", "ess9_ches.csv"))
ess10 = read.csv(here::here("data", "ess10_ches.csv"))
ess = rbind(ess9, ess10)

table(ess$status)
table(ess10$feethngr, ess10$status, useNA = "always")
table(ess9$livecnta)
```

#data structure and merge
```{r}
ess = ess[ , c("party", "country", "essround", "idno", 
               "dweight", "anweight", "pweight", "lrscale",
                 "status", "age", "gender", "vote",
                 "religion", "education", "impol1", "impol2",
                  "impol3", "imbgeco", "imueclt", "imwbcnt", "stfdem" ,
               "dscrgrp", "dscrrce", "dscrntn", "dscrrlg", "dscretn", "feethngr", "livecnta")]

#for some reasons, they don't match jobbik.
unique(ess$party[ess$country == "HU"])
unique(ches$party[ches$country == "HU"])
ess$party[ess$party == "Jobbik" & ess$country == "HU"] = "JOBBIK"

ches = rename(ches, voteshare = vote)
ess_ches = merge(ess, ches, by = c("party", "country"), all.x = TRUE)
ess_ches = subset(ess_ches, !is.na(party) & party != "")
ess_ches = subset(ess_ches, !is.na(immigrate_policy))
length(table(ess_ches$party))
