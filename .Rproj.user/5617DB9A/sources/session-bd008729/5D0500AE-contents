```{r} 
#find unmatched parties
unmatched_parties = ess[!(ess$party %in% ches$party), c("party", "country")]
unmatched_parties$count = ave(unmatched_parties$party, unmatched_parties$party, unmatched_parties$country, FUN = length)
unique_unmatched = unique(unmatched_parties)
unique_unmatched$count = as.numeric(unique_unmatched$count)

unique_parties= unique_unmatched %>% arrange(desc(count))
print(unique_parties)
```

